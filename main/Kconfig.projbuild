menu "InfraBadge firmware"
choice IB_M0_PROFILE
    prompt "Hardware bring-up profile"
    default IB_M0_DISPLAY
config IB_M0_DISPLAY
    bool "1: Display InfraBadge M0 once"
config IB_M0_SENSORS
    bool "2: Battery, read-only RTC and SHTC3"
config IB_M0_SLEEP
    bool "3: One deep-sleep/wake cycle"
config IB_M1_UI
    bool "M1: offline display and button navigation"
config IB_M11_TIMER_DIAG
    bool "M1.1: manual start, three autonomous timer-only cycles"
config IB_M2_CONNECTIVITY
    bool "M2: provisioned STA/verified HTTPS, conditional render and sleep"
endchoice
config IB_M2_AUTO_DIAG
    bool "Separate autonomous M2 validation application (never production defaults)"
    depends on IB_M2_CONNECTIVITY
    default n
config IB_M35_UI
    bool "M3.5 bounded multisite UI, separate application"
    depends on IB_M2_CONNECTIVITY && !IB_M2_AUTO_DIAG
    default n
config IB_M36_ROAMING
    bool "M3.6 bounded roaming and night policy, separate profile"
    depends on IB_M35_UI
    default n
config IB_M0_SLEEP_SECONDS
    int "Deep sleep duration (seconds)"
    range 1 3600
    default 10
config IB_M0_WAKE_BUTTONS
    bool "Allow BOOT/PWR wake in addition to timer"
    default y
config IB_M1_SLEEP_SECONDS
    int "M1 timer wake duration (seconds)"
    range 1 3600
    default 60
endmenu
