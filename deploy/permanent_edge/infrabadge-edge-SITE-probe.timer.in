# INERT: no linger required for the future system timer; nothing is enabled here.
[Unit]
Description=InfraBadge @SITE@ periodic health

[Timer]
OnBootSec=45s
OnUnitInactiveSec=60s
AccuracySec=5s
RandomizedDelaySec=5s
Persistent=false
WakeSystem=false
Unit=infrabadge-edge-@SITE@-probe.service

[Install]
WantedBy=timers.target
