# INERT: probe credentials MUST differ from the badge identity.
[Unit]
Description=InfraBadge @SITE@ verified HTTPS probe
After=infrabadge-edge-@SITE@.service

[Service]
Type=oneshot
User=@EDGE_USER@
Group=@EDGE_USER@
Environment=PYTHONPATH=@RELEASE@/gateway
ExecStart=@RELEASE@/venv/bin/python -I -B @RELEASE@/tools/permanent_edge/ib_edge_lab.py probe --config /etc/infrabadge-edge-@SITE@/probe.json
TimeoutStartSec=15s
UMask=0077
NoNewPrivileges=true
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectClock=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
MemoryMax=128M
TasksMax=8
StandardOutput=journal
StandardError=journal
