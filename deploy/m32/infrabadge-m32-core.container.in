# INERT TEMPLATE: substitute approved immutable image/IP; review site preflight first.
[Unit]
Description=InfraBadge M3.2 core

[Container]
Image=@IMAGE_ID@
Pull=never
ContainerName=infrabadge-m32-core
UserNS=keep-id:uid=10001,gid=10001
User=10001:10001
ReadOnly=true
NoNewPrivileges=true
DropCapability=all
PublishPort=@TAILNET_IPV4@:9443:8443
Volume=%h/.config/infrabadge/m32-core:/run/infrabadge:ro,Z
LogDriver=none
PodmanArgs=--memory=256m --pids-limit=64 --cpus=1
Volume=%h/.local/share/infrabadge-m32:/var/lib/infrabadge:rw,Z

[Service]
Restart=on-failure
RestartSec=15s
TimeoutStartSec=90s
TimeoutStopSec=20s
UMask=0077

[Install]
WantedBy=default.target
