# INERT TEMPLATE: substitute approved immutable image/IP; review site preflight first.
[Unit]
Description=InfraBadge M3.2 edge

[Container]
Image=@IMAGE_ID@
Pull=never
ContainerName=infrabadge-m32-edge
UserNS=keep-id:uid=10001,gid=10001
User=10001:10001
ReadOnly=true
NoNewPrivileges=true
DropCapability=all
PublishPort=@LAN_IPV4@:8443:8443
Volume=%h/.config/infrabadge/m32-edge:/run/infrabadge:ro,Z
LogDriver=none
PodmanArgs=--memory=256m --pids-limit=64 --cpus=1
Exec=edge --config /run/infrabadge/edge.json --cert /run/infrabadge/server.pem --key /run/infrabadge/server.key --bind 0.0.0.0 --port 8443

[Service]
Restart=on-failure
RestartSec=15s
TimeoutStartSec=90s
TimeoutStopSec=20s
UMask=0077

[Install]
WantedBy=default.target
