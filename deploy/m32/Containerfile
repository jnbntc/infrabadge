FROM docker.io/library/python:3.12-slim-bookworm@sha256:34386ef0cb081344d7ec1c103ba398e6e9f64e9ab3a1509accc92a4e24a07258
ARG SOURCE_DATE_EPOCH=0
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app
COPY gateway/requirements.lock /app/requirements.lock
RUN python -m pip install --no-cache-dir --no-compile --require-hashes -r /app/requirements.lock
COPY gateway/infrabadge_gateway /app/infrabadge_gateway
USER 10001:10001
EXPOSE 8443
ENTRYPOINT ["python", "-m", "infrabadge_gateway.distributed.cli"]
CMD ["core", "--config", "/run/infrabadge/core.json", "--database", "/var/lib/infrabadge/core.db", "--cert", "/run/infrabadge/server.pem", "--key", "/run/infrabadge/server.key", "--bind", "0.0.0.0", "--port", "8443"]
