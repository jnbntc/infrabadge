# CANDIDATE ONLY. Replaces the existing gateway unit; never run a second backend.
[Unit]
Description=InfraBadge gateway with local ingestion and guarded LAN reads
Requires=infrabadge-lan-guard.timer
Wants=infrabadge-lan-guard.service
After=infrabadge-lan-guard.service
StartLimitIntervalSec=0

[Container]
Image=@IMAGE@
Pull=never
ContainerName=infrabadge-gateway-m3
UserNS=keep-id:uid=10001,gid=10001
User=10001:10001
ReadOnly=true
NoNewPrivileges=true
DropCapability=all
PublishPort=127.0.0.1:8443:8443
PublishPort=@ADDRESS@:8443:8444
Volume=%h/.config/infrabadge/m31:/run/infrabadge:ro,Z
Volume=%t/infrabadge-lan-guard:/run/network-guard:ro,Z
Volume=%t/infrabadge-lan-telemetry:/run/telemetry:rw,Z
LogDriver=none
PodmanArgs=--memory=256m --pids-limit=64 --cpus=1

[Service]
RuntimeDirectory=infrabadge-lan-telemetry
RuntimeDirectoryMode=0700
ExecStartPre=/usr/bin/python3 -I %h/.local/share/infrabadge-lan-guard/infrabadge-lan-guard.pyz --policy %h/.config/infrabadge/m31/policy.json --lease %t/infrabadge-lan-guard/lease.json --require-approved
Restart=on-failure
RestartSec=15s
TimeoutStartSec=90s
TimeoutStopSec=20s

[Install]
WantedBy=default.target
