CONFIG_IB_M2_CONNECTIVITY=y
CONFIG_ESP_WIFI_ENABLED=y
CONFIG_ESP_HTTP_CLIENT_ENABLE_HTTPS=y
# CONFIG_ESP_TLS_INSECURE is not set
# CONFIG_ESP_TLS_SKIP_SERVER_CERT_VERIFY is not set
CONFIG_ESP_MAIN_TASK_STACK_SIZE=24576
CONFIG_LOG_DEFAULT_LEVEL_WARN=y
# Keep SDK logs quiet, but retain the explicitly enabled, sanitized M2 INFO events.
CONFIG_LOG_MAXIMUM_LEVEL_INFO=y
CONFIG_MBEDTLS_HAVE_TIME=y
CONFIG_MBEDTLS_HAVE_TIME_DATE=y

CONFIG_IB_M35_UI=y

CONFIG_IB_M36_ROAMING=y
